{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Notes",
  "version": "0.2.0",
  "identifier": "dev.notes.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Notes",
        "width": 1280,
        "height": 840,
        "minWidth": 720,
        "minHeight": 520,
        "decorations": false,
        "resizable": true,
        "backgroundColor": "#06080a"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
