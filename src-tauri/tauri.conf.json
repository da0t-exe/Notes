{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Notes",
  "version": "0.4.0",
  "identifier": "dev.notes.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Notes",
        "width": 1280,
        "height": 840,
        "minWidth": 720,
        "minHeight": 520,
        "decorations": false,
        "resizable": true,
        "backgroundColor": "#06080a",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "Notes",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false,
        "compression": "lzma",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp"
      }
    },
    "publisher": "da0t-exe",
    "copyright": "Copyright (c) 2026 da0t-exe. MIT licensed.",
    "category": "Productivity",
    "shortDescription": "A minimalist native text editor for Windows.",
    "longDescription": "Notes opens any text file, detects its encoding and line endings, and shows Markdown syntax only on the line you are editing. Checklists, pinning and a recoverable trash for the notes it keeps itself. No telemetry, no network access.",
    "homepage": "https://github.com/da0t-exe/Notes",
    "licenseFile": "../LICENSE"
  }
}
